{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "SimplePlane",
  "version": "0.2.3",
  "identifier": "com.simpleplane.desktop",
  "build": {
    "frontendDist": "../web",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "SimplePlane",
        "width": 1100,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/proxy-local.jar",
      "resources/jre/**/*",
      "resources/web/**/*",
      "resources/config-templates/**/*",
      "resources/tun-adapter*",
      "resources/wintun.dll"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "skip"
      },
      "wix": null,
      "nsis": {
        "installMode": "both",
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "updater": {
      "dangerousInsecureTransportProtocol": true,
      "endpoints": [
        "https://github.com/zhh293/SimplePlanePlatform/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUwRThDQzZBRDBFMEI2MTQKUldRVXR1RFFhc3pvNEpYWjdCNmpZT1JPY1RqNTRVSVR3R1Y3UkZqaThheXNNZkN0T0NjZFRDVFYK",
      "bootstrap": {
        "endpoints": [
          "https://raw.githubusercontent.com/zhh293/SimplePlanePlatform/main/bootstrap.json",
          "https://zhh293.github.io/SimplePlanePlatform/bootstrap.json"
        ],
        "cache_ttl_seconds": 3600,
        "_comment": "Bootstrap URLs are fetched at startup to discover the current update-server URL. Updating this list requires a new client build; the update-server URL itself (returned by the bootstrap JSON) can be changed without rebuilding the client."
      }
    }
  }
}
