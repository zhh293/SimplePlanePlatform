# Update server runtime config (NON-SECRET — safe to commit).
# All sensitive values (SRP verifier, session secret) must NOT be here.
# See docs/deployment.md for production setup with systemd LoadCredential.

HOST=127.0.0.1
PORT=8787
DATA_DIR=./data
PUBLIC_BASE_URL=https://update.example.com

# Session cookie HMAC key — generate with: openssl rand -hex 32
# Store in /etc/simpleplane-update.env (chmod 600) or systemd EnvironmentFile.
SESSION_SECRET=

# SRP verifier file path — generated by scripts/generate-srp-credentials.mjs
# In production, prefer systemd LoadCredential (see deployment.md) over this env.
# Development: point to ./data/verifier.json
SRP_VERIFIER_FILE=

# Upload limits
MAX_FILE_SIZE=1073741824
MAX_CHUNK_SIZE=33554432
DEFAULT_CHUNK_SIZE=8388608
UPLOAD_SESSION_TTL_HOURS=24
MAX_ACTIVE_UPLOADS=5

# NOTE: ADMIN_PASSWORD_HASH is deprecated (scrypt-based login removed).
# Use /admin/srp/challenge + /admin/srp/verify PAKE handshake instead.
# See docs/srp-auth-design.md.
