<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SimplePlane" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:statusBarColor">@color/app_background</item>
        <item name="android:navigationBarColor">@color/app_background</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="colorPrimary">@color/app_primary</item>
        <item name="colorOnPrimary">@color/app_on_primary</item>
        <item name="colorPrimaryContainer">@color/app_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/app_on_primary_container</item>
        <item name="colorSecondaryContainer">@color/app_primary_container</item>
        <item name="colorOnSecondaryContainer">@color/app_on_primary_container</item>
        <item name="colorSurface">@color/app_surface</item>
        <item name="elevationOverlayEnabled">false</item>
        <item name="bottomSheetDialogTheme">@style/PlaneSheetDialog</item>
        <item name="colorOnSurface">@color/app_text_primary</item>
        <item name="colorOnSurfaceVariant">@color/app_text_secondary</item>
        <item name="colorOutline">@color/app_outline</item>
        <item name="android:colorBackground">@color/app_background</item>
        <item name="textInputStyle">@style/PlaneInput</item>
    </style>

    <style name="PlaneInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxBackgroundColor">@color/app_surface</item>
        <item name="boxStrokeColor">@color/input_outline</item>
    </style>

    <style name="AppSectionTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">24dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textColor">@color/app_text_primary</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="AppPageTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textSize">32sp</item>
        <item name="android:letterSpacing">-0.025</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/app_text_primary</item>
    </style>

    <style name="DashboardCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="cardCornerRadius">26dp</item>
        <item name="cardElevation">1dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/surface_edge</item>
        <item name="cardBackgroundColor">@color/app_surface</item>
    </style>
    <style name="DashboardMetric" parent="DashboardCard">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="cardCornerRadius">17dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
    </style>
    <style name="PlaneSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/PlaneBottomSheet</item>
    </style>
    <style name="PlaneBottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@color/app_surface</item>
        <item name="shapeAppearanceOverlay">@style/PlaneSheetCorners</item>
    </style>
    <style name="PlaneSheetCorners" parent="">
        <item name="cornerSizeTopLeft">30dp</item>
        <item name="cornerSizeTopRight">30dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>
    <style name="DashboardSection" parent="AppBodyText">
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/app_text_primary</item>
    </style>
    <style name="AppBodyText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
        <item name="android:textColor">@color/app_text_secondary</item>
    </style>
</resources>
